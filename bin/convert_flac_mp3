#!/bin/bash

if [[ $# -ne 2 ]]; then
    echo "Usage: $(basename "$0") <input_dir> <output_dir>" >&2
    exit 1
fi

INPUT_DIR="$1"
OUTPUT_DIR="$2"

if [[ ! -d "$INPUT_DIR" ]]; then
    echo "Error: input dir '$INPUT_DIR' does not exist" >&2
    exit 1
fi

if ! command -v ffmpeg &>/dev/null; then
    echo "Error: ffmpeg not found" >&2
    exit 1
fi

# Create output directory if it doesn't exist
mkdir -p "$OUTPUT_DIR"

files=()
while IFS= read -r f; do files+=("$f"); done < <(find "$INPUT_DIR" -maxdepth 1 -name "*.flac" | sort)
total=${#files[@]}

if [[ $total -eq 0 ]]; then
    echo "No .flac files found in '$INPUT_DIR'" >&2
    exit 1
fi

JOBS=${JOBS:-$(nproc 2>/dev/null || sysctl -n hw.logicalcpu)}
running=0
done_count=0

for i in "${!files[@]}"; do
    file="${files[$i]}"
    fallback=$(basename "$file" .flac)

    artist=$(ffprobe -v quiet -show_entries format_tags=artist -of default=noprint_wrappers=1:nokey=1 "$file" | tr -d '\r')
    title=$(ffprobe -v quiet -show_entries format_tags=title -of default=noprint_wrappers=1:nokey=1 "$file" | tr -d '\r')

    if [[ -n "$artist" && -n "$title" ]]; then
        outname="${artist} - ${title}"
    else
        outname="$fallback"
    fi

    # Strip chars illegal in filenames
    outname=$(echo "$outname" | tr '/\\:*?"<>|' '_')

    echo "[$((i+1))/$total] $outname"
    ffmpeg -y -i "$file" -ab 320k "$OUTPUT_DIR/$outname.mp3" -loglevel error &
    ((running++))
    if [[ $running -ge $JOBS ]]; then
        wait -n 2>/dev/null || wait
        ((running--))
    fi
done

wait
echo "Done."

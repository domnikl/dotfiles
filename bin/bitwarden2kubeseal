#!/usr/bin/env python

import subprocess
import argparse
import json
import tempfile
import os
import sys
import base64

def sync_vault():
    """Sync the Bitwarden vault using `bw sync`."""
    try:
        subprocess.run(
            ["bw", "sync"],
            check=True
        )
    except subprocess.CalledProcessError as e:
        print(f"Error syncing the Bitwarden vault: {e.stderr}", file=sys.stderr)
        sys.exit(1)

def get_password_from_bitwarden(entry_name):
    """Fetch the password from Bitwarden using `bw get password`."""

    params = ["bw", "get", "password", entry_name]

    try:
        result = subprocess.run(
            params,
            capture_output=True,
            text=True,
            check=True
        )
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        print(f"Error retrieving password from Bitwarden: {e.stderr}", file=sys.stderr)
        sys.exit(1)


def create_kubernetes_secret(secret_name, secret_key, password, namespace):
    """Generate a Kubernetes secret YAML."""
    secret_data = {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {
            "name": secret_name
        },
        "data": {
            secret_key: base64.b64encode(password.encode()).decode('ascii')
        }
    }

    if namespace:
        secret_data["metadata"]["namespace"] = namespace
    
    return json.dumps(secret_data, indent=4)


def seal_secret(secret_yaml, scope, namespace):
    """Seal the secret using kubeseal."""
    try:
        with tempfile.NamedTemporaryFile(delete=False, mode="w") as temp_file:
            temp_file.write(secret_yaml)
            temp_file_path = temp_file.name

        result = subprocess.run(
            ["kubeseal", "--scope", scope, "--namespace", namespace, "--format", "yaml", "-f", temp_file_path],
            capture_output=True,
            text=True,
            check=True
        )

        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        print(f"Error sealing the secret: {e.stderr}", file=sys.stderr)
        print(temp_file_path)
        sys.exit(1)
    finally:
        if os.path.exists(temp_file_path):
            os.remove(temp_file_path)


def main():
    parser = argparse.ArgumentParser(description="Create a SealedSecret from a Bitwarden password.")
    parser.add_argument("--entry", required=True, help="Name or search term of the entry in Bitwarden.")
    parser.add_argument("--secret-name", required=True, help="Name of the Kubernetes secret.")
    parser.add_argument("--secret-key", required=True, help="Key for the secret.")
    parser.add_argument("--namespace", help="Kubernetes namespace (optional).")
    parser.add_argument("--scope", default="strict", help="Sealing scope (default: strict).")
    args = parser.parse_args()

    sync_vault()

    password = get_password_from_bitwarden(args.entry)
    secret_yaml = create_kubernetes_secret(args.secret_name, args.secret_key, password, args.namespace)
    sealed_secret = seal_secret(secret_yaml, args.scope or "strict", args.namespace or "default")

    if sealed_secret:
        print(sealed_secret)
    else:
        print("Failed to create the secret.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
